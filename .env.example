# Public publisher identifier, embedded in the app bundle. Not a secret API key.
EXPO_PUBLIC_TENPING_MEMBER_ID=
EXPO_PUBLIC_ADPICK_AFFILIATE_ID=

# Public AdMob ad unit IDs. Use / unit IDs here, not the ~ application ID.
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID=
# Use the adtest EAS profile for a release APK with Google's test ad units.
EXPO_PUBLIC_ADMOB_TEST_ADS=0
