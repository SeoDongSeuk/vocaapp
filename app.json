{
  "expo": {
    "name": "워드챌린지",
    "slug": "vocab-race",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/wordrush-splash.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#F7F6FB"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager creates these classes by reflection during Android startup.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }"
          }
        }
      ]
    ],
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 3,
      "package": "com.wordrush.vocabrush",
      "adaptiveIcon": {
        "backgroundColor": "#F0EBFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "splash": {
        "image": "./assets/wordrush-splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#F7F6FB"
      }
    },
    "extra": {
      "eas": {
        "projectId": "3be4ea00-00d5-4138-8ef8-84c48ddd0cbc"
      }
    }
  }
}
