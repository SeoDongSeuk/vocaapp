{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "developmentClient": false,
      "node": "24.22.1",
      "pnpm": "12.16.1",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "preview",
      "distribution": "store",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_ADMOB_TEST_ADS": "0"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "adtest": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_ADMOB_TEST_ADS": "1"
      }
    }
  }
}
